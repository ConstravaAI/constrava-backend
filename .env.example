PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5-mini
RESEND_API_KEY=
# Use a verified Resend sending domain, for example: Constrava <handoff@updates.example.com>
DEVELOPER_HANDOFF_FROM=
# Optional. If empty, developer replies go to the signed-in user's account email.
DEVELOPER_HANDOFF_REPLY_TO=
SESSION_SECRET=replace-me-before-production
SESSION_MAX_AGE_SECONDS=7776000
DATABASE_URL=
DATABASE_POOL_SIZE=5
# Set PGSSLMODE=disable only for a trusted local Postgres server without TLS.
PGSSLMODE=require
DATA_DIR=
DATA_FILE=
# Preferred production storage: set DATABASE_URL to the Neon pooled connection string.
# Constrava also extracts the URL when Neon copied it as: psql 'postgresql://...'
# File-store alternative on paid Render: attach a persistent disk at /var/data, then set:
# DATA_DIR=/var/data
