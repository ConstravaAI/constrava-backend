PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5-mini
RESEND_API_KEY=
# Use a verified Resend sending domain, for example: Constrava <handoff@updates.example.com>
DEVELOPER_HANDOFF_FROM=
# Optional. If empty, developer replies go to the signed-in user's account email.
DEVELOPER_HANDOFF_REPLY_TO=
SESSION_SECRET=replace-me-before-production
SESSION_MAX_AGE_SECONDS=7776000
# Encrypts OAuth tokens saved for connected resources. Use one stable, random value in production.
EMAIL_TOKEN_ENCRYPTION_KEY=

# Google OAuth. Google Sheets can reuse either the Calendar or Gmail client below.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=

# CRM and business-tool OAuth apps. Configure only the providers you offer.
# Authorized callback URL for every provider: https://constravaai.com/api/business-tools/oauth/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
DATABASE_URL=
DATABASE_POOL_SIZE=5
# Deployment 2 creates empty normalized tables but keeps the existing JSONB store
# as the only active source of truth. Do not enable shadow or relational yet.
DATA_STORAGE_MODE=legacy
# Set PGSSLMODE=disable only for a trusted local Postgres server without TLS.
PGSSLMODE=require
DATA_DIR=
DATA_FILE=
# Preferred production storage: set DATABASE_URL to the Neon pooled connection string.
# Constrava also extracts the URL when Neon copied it as: psql 'postgresql://...'
# File-store alternative on paid Render: attach a persistent disk at /var/data, then set:
# DATA_DIR=/var/data
